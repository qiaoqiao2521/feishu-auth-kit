{
  "version": 1,
  "targets": [
    {
      "key": "openclaw-lark",
      "repo": "larksuite/openclaw-lark",
      "branch": "main",
      "mode": "plugin",
      "routes": [
        {
          "platform": "feishu",
          "contracts": [
            "adapter"
          ],
          "paths": [
            "src/**",
            "openclaw.plugin.json",
            "index.ts",
            "index.test.ts"
          ]
        },
        {
          "platform": "feishu",
          "contracts": [
            "auth"
          ],
          "paths": [
            "src/**auth*",
            "src/**oauth*",
            "src/**token*",
            "src/**scope*",
            "src/**registration*"
          ]
        },
        {
          "platform": "feishu",
          "contracts": [
            "message",
            "policy"
          ],
          "paths": [
            "src/messaging/inbound/**",
            "src/channel/**"
          ]
        },
        {
          "platform": "feishu",
          "contracts": [
            "delivery",
            "streaming",
            "cards"
          ],
          "paths": [
            "src/card/**",
            "src/messaging/outbound/**"
          ]
        },
        {
          "platform": "feishu",
          "contracts": [
            "dependencies"
          ],
          "paths": [
            "package.json"
          ]
        },
        {
          "platform": "feishu",
          "contracts": [
            "protocol"
          ],
          "docs": [
            "docs/protocol*.md",
            "docs/auth*.md"
          ]
        }
      ]
    },
    {
      "key": "openclaw-core",
      "repo": "openclaw/openclaw",
      "branch": "main",
      "mode": "core",
      "routes": [
        {
          "platform": "feishu",
          "contracts": [
            "adapter"
          ],
          "paths": [
            "extensions/feishu/**"
          ]
        },
        {
          "platform": "feishu",
          "contracts": [
            "auth"
          ],
          "paths": [
            "extensions/feishu/**auth*",
            "extensions/feishu/**token*",
            "extensions/feishu/**registration*"
          ]
        },
        {
          "platform": "feishu",
          "contracts": [
            "protocol"
          ],
          "docs": [
            "docs/channels/feishu.md"
          ]
        },
        {
          "platform": "telegram",
          "contracts": [
            "adapter"
          ],
          "paths": [
            "extensions/telegram/**",
            "src/telegram/**"
          ]
        },
        {
          "platform": "telegram",
          "contracts": [
            "auth",
            "policy"
          ],
          "paths": [
            "extensions/telegram/**auth*",
            "src/telegram/**auth*",
            "src/telegram/**access*"
          ]
        },
        {
          "platform": "telegram",
          "contracts": [
            "protocol"
          ],
          "docs": [
            "docs/channels/telegram.md"
          ]
        },
        {
          "platform": "qq",
          "contracts": [
            "adapter"
          ],
          "paths": [
            "extensions/qqbot/**"
          ]
        },
        {
          "platform": "weixin",
          "contracts": [
            "adapter"
          ],
          "paths": [
            "extensions/weixin/**",
            "extensions/wechat/**"
          ]
        },
        {
          "platform": "shared",
          "contracts": [
            "message",
            "delivery",
            "runtime"
          ],
          "paths": [
            "src/plugin-sdk/*channel*",
            "src/plugin-sdk/*card*",
            "src/plugin-sdk/*interactive*",
            "src/plugin-sdk/*session-runner*",
            "src/channels/plugins/contracts/**"
          ]
        },
        {
          "platform": "shared",
          "contracts": [
            "dependencies"
          ],
          "paths": [
            "package.json",
            "pnpm-lock.yaml"
          ]
        }
      ]
    },
    {
      "key": "openclaw-qqbot",
      "repo": "tencent-connect/openclaw-qqbot",
