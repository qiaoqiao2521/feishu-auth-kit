    {
      "key": "hermes-agent",
      "repo": "NousResearch/hermes-agent",
      "branch": "main",
      "mode": "selective",
      "routes": [
        {
          "platform": "feishu",
          "contracts": [
            "adapter"
          ],
          "paths": [
            "plugins/platforms/*feishu*",
            "plugins/platforms/*lark*",
            "gateway/platforms/*feishu*",
            "gateway/platforms/*lark*"
          ]
        },
        {
          "platform": "telegram",
          "contracts": [
            "adapter",
            "message",
            "delivery"
          ],
          "paths": [
            "plugins/platforms/*telegram*",
            "gateway/platforms/*telegram*"
          ]
        },
        {
          "platform": "qq",
          "contracts": [
            "adapter"
          ],
          "paths": [
            "plugins/platforms/*qq*",
            "gateway/platforms/*qq*"
          ]
        },
        {
          "platform": "weixin",
          "contracts": [
            "adapter"
          ],
          "paths": [
            "plugins/platforms/*weixin*",
            "plugins/platforms/*wechat*",
            "gateway/platforms/*weixin*",
            "gateway/platforms/*wechat*"
          ]
        },
        {
          "platform": "shared",
          "contracts": [
            "message",
            "delivery",
            "runtime"
          ],
          "paths": [
            "plugins/platforms/base.py",
            "plugins/platforms/__init__.py",
            "gateway/platforms/base.py",
            "gateway/platforms/__init__.py",
            "gateway/platforms/base/**",
            "gateway/platforms/shared/**",
            "gateway/platforms/base_*.py",
            "gateway/platforms/_shared.py",
            "gateway/platforms/event.py",
            "gateway/platforms/send_targets.py",
            "gateway/platforms/shared_ingress.py",
            "gateway/platforms/webhook*.py"
          ]
        },
        {
          "platform": "shared",
          "contracts": [
            "dependencies"
          ],
          "paths": [
            "pyproject.toml",
            "requirements*.txt",
            "uv.lock"
          ]
        },
        {
          "platform": "telegram",
          "contracts": [
            "protocol"
          ],
          "docs": [
            "docs/*telegram*",
            "docs/**telegram*",
            "website/docs/**telegram*"
          ]
        },
        {
          "platform": "feishu",
          "contracts": [
            "protocol"
          ],
          "docs": [
            "docs/*feishu*",
            "docs/**feishu*",
            "website/docs/**feishu*"
          ]
        },
        {
          "platform": "shared",
          "contracts": [
            "auth",
            "policy"
          ],
          "paths": [
            "gateway/platforms/access_policy_mixin.py"
          ]
        }
      ]
    },
    {
