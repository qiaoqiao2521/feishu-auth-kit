          ]
        },
        {
          "platform": "shared",
          "contracts": [
            "dependencies"
          ],
          "paths": [
            "packages/chat/package.json"
          ]
        },
        {
          "platform": "telegram",
          "contracts": [
            "adapter",
            "message",
            "delivery"
          ],
          "paths": [
            "packages/adapter-telegram/src/**",
