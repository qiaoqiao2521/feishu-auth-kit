# Node 24 --env-file syntax. Copy to .env.telegram (gitignored), chmod 600.
TELEGRAM_BOT_TOKEN=123456789:replace_with_BotFather_token
TELEGRAM_BOT_USERNAME=your_pilot_bot
TELEGRAM_WEBHOOK_SECRET_TOKEN=replace_with_a_random_secret
# Fill after `pnpm telegram:ids`; IDs MUST be JSON strings, topicId an integer.
TELEGRAM_GRANTS='[{"userId":"42","chatId":"42"}]'
# Optional for a forum topic:
# TELEGRAM_GRANTS='[{"userId":"42","chatId":"-1001234567890","topicId":9}]'
TELEGRAM_HOST=127.0.0.1
TELEGRAM_PORT=8787
TELEGRAM_WEBHOOK_URL=https://your-public-host.example/webhooks/telegram
