        }
      ]
    },
    {
      "key": "openclaw-weixin",
      "repo": "Tencent/openclaw-weixin",
      "branch": "main",
      "mode": "selective",
      "routes": [
        {
          "platform": "weixin",
          "contracts": [
            "adapter",
            "message",
            "delivery"
