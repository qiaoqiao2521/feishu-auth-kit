{
  "name": "feishu-auth-kit",
  "version": "0.1.0",
  "description": "Feishu-compatible channel kit with shared message and runner contracts and Telegram Bot API primitives.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "feishu-auth-kit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./feishu": { "types": "./dist/feishu.d.ts", "import": "./dist/feishu.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./telegram": { "types": "./dist/telegram/index.d.ts", "import": "./dist/telegram/index.js" },
    "./telegram-host": { "types": "./dist/telegram/polling-host.d.ts", "import": "./dist/telegram/polling-host.js" }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:package": "node scripts/check-package.mjs",
    "telegram:echo": "node examples/telegram-echo.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
